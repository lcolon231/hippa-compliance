generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per medical office (the paying customer)
model Organization {
  id        String   @id @default(cuid())
  name      String
  npi       String? // National Provider Identifier (optional)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Stripe billing
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  currentPeriodEnd     DateTime?

  users         User[]
  tasks         ComplianceTask[]
  reports       Report[]
  orgFrameworks OrgFramework[]
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id             String       @id @default(cuid())
  supabaseId     String       @unique // maps to Supabase auth.users.id
  email          String       @unique
  name           String?
  role           Role         @default(MEMBER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  assignedTasks ComplianceTask[] @relation("TaskAssignee")
  evidence      Evidence[]

  @@index([organizationId])
}

enum Role {
  ADMIN // office manager / owner
  MEMBER // staff
}

// Master list of supported compliance frameworks
model Framework {
  id          String @id @default(cuid())
  slug        String @unique // "hipaa-security", "hipaa-privacy", "nist-csf"
  name        String
  description String
  sortOrder   Int

  templates     TaskTemplate[]
  orgFrameworks OrgFramework[]
}

// Which frameworks an org has opted into
model OrgFramework {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  frameworkId    String
  framework      Framework    @relation(fields: [frameworkId], references: [id])
  enabledAt      DateTime     @default(now())

  @@unique([organizationId, frameworkId])
  @@index([organizationId])
}

// The master checklist template — seeded once, shared by all orgs
model TaskTemplate {
  id          String    @id @default(cuid())
  frameworkId String?
  framework   Framework? @relation(fields: [frameworkId], references: [id])
  category    Category
  citation    String
  title       String
  description String
  guide       String?   @db.Text // Markdown "how to comply" walkthrough (optional)
  sortOrder   Int

  tasks ComplianceTask[]

  @@index([frameworkId])
}

enum Category {
  // HIPAA Security Rule (164.308-316)
  ADMINISTRATIVE
  PHYSICAL
  TECHNICAL
  ORGANIZATIONAL
  POLICIES

  // HIPAA Privacy Rule (164.500-534)
  PRIVACY_PRACTICES
  PRIVACY_USES
  PRIVACY_WORKFORCE

  // NIST Cybersecurity Framework 1.1
  CSF_IDENTIFY
  CSF_PROTECT
  CSF_DETECT
  CSF_RESPOND
  CSF_RECOVER
}

// Each org's instance of a template task
model ComplianceTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  templateId     String
  template       TaskTemplate @relation(fields: [templateId], references: [id])

  status         TaskStatus @default(NOT_STARTED)
  assigneeId     String?
  assignee       User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate        DateTime?
  notes          String?    @db.Text
  completedAt    DateTime?
  reminderSentAt DateTime?
  updatedAt      DateTime   @updatedAt

  evidence Evidence[]

  @@unique([organizationId, templateId])
  @@index([organizationId, status])
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
  NOT_APPLICABLE
}

// Files attached to tasks (stored in Supabase Storage)
model Evidence {
  id           String         @id @default(cuid())
  taskId       String
  task         ComplianceTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  fileName     String
  storagePath  String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  @@index([taskId])
}

// Generated PDF compliance reports
model Report {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scoreAtExport  Int
  storagePath    String
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}
