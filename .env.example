# Neon Postgres (pooled + direct connections)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# Supabase (Auth + Storage)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxx"
SUPABASE_SERVICE_ROLE_KEY="xxx"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe (billing)
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_PRICE_ID="price_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# Resend (due-date reminder emails)
RESEND_API_KEY="re_xxx"
EMAIL_FROM="HIPAA Tracker <reminders@yourdomain.com>"

# Cron protection (Vercel sends this as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET="generate-a-long-random-string"
